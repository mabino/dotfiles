#!/usr/bin/env python3
"""Reconcile Brewfiles across machines by unioning their entries.

Usage:
  brewfile-reconcile union FILE1 FILE2 [--remove NAME ...] [-o OUT]
      Union the entries of FILE1 and FILE2. FILE1 (typically a fresh
      `brew bundle dump`) takes priority for ordering and entry options;
      entries only present in FILE2 are appended to their directive group.
      --remove drops matching entries (used when a package was uninstalled).
      Writes to OUT (may equal an input file) or stdout.

  brewfile-reconcile git-merge ANCESTOR OURS THEIRS
      Git merge driver: writes the union of OURS and THEIRS to OURS.
      Configure with:
        git config merge.brewfile-union.driver \
          'brewfile-reconcile git-merge %O %A %B'
      and in .gitattributes:
        .Brewfile merge=brewfile-union
"""

import re
import sys

ENTRY_RE = re.compile(r'^\s*(tap|brew|cask|mas|whalebrew|vscode|cargo|go)\s+"([^"]+)"')


class Entry:
    def __init__(self, directive, name, lines, comments):
        self.directive = directive
        self.name = name
        self.lines = lines          # the directive line(s)
        self.comments = comments    # preceding comment lines

    @property
    def key(self):
        return (self.directive, self.name)


def parse(path):
    """Return a list of Entry objects from a Brewfile (empty if missing)."""
    entries = []
    comments = []
    try:
        f = open(path, encoding="utf-8")
    except FileNotFoundError:
        return entries
    with f:
        for line in f:
            line = line.rstrip("\n")
            if not line.strip():
                continue
            if line.lstrip().startswith("#"):
                comments.append(line)
                continue
            m = ENTRY_RE.match(line)
            if m:
                entries.append(Entry(m.group(1), m.group(2), [line], comments))
            else:
                # Unknown line: preserve it verbatim, keyed by its own text.
                entries.append(Entry("_raw", line, [line], comments))
            comments = []
    return entries


def union(primary, secondary, removals=()):
    """Union two entry lists. Primary wins on duplicates and sets the order;
    secondary-only entries are appended after the last entry of the same
    directive (or at the end). Removals match an entry's name or its last
    path component (so `untap user/repo` matches tap "user/repo")."""
    removals = set(removals)

    def removed(e):
        return e.name in removals or e.name.split("/")[-1] in removals

    result = [e for e in primary if not removed(e)]
    seen = {e.key for e in result}
    for e in secondary:
        if e.key in seen or removed(e):
            continue
        idx = max((i for i, r in enumerate(result) if r.directive == e.directive),
                  default=len(result) - 1)
        result.insert(idx + 1, e)
        seen.add(e.key)
    return result


def render(entries):
    lines = []
    for e in entries:
        lines.extend(e.comments)
        lines.extend(e.lines)
    return "\n".join(lines) + "\n" if lines else ""


def main(argv):
    if len(argv) >= 4 and argv[0] == "git-merge":
        ours, theirs = argv[2], argv[3]
        merged = render(union(parse(ours), parse(theirs)))
        with open(ours, "w", encoding="utf-8") as f:
            f.write(merged)
        return 0

    if len(argv) >= 3 and argv[0] == "union":
        file1, file2, rest = argv[1], argv[2], argv[3:]
        removals, out = [], None
        i = 0
        while i < len(rest):
            if rest[i] == "--remove" and i + 1 < len(rest):
                removals.append(rest[i + 1])
                i += 2
            elif rest[i] in ("-o", "--output") and i + 1 < len(rest):
                out = rest[i + 1]
                i += 2
            else:
                print(f"unknown argument: {rest[i]}", file=sys.stderr)
                return 2
        merged = render(union(parse(file1), parse(file2), removals))
        if out:
            with open(out, "w", encoding="utf-8") as f:
                f.write(merged)
        else:
            sys.stdout.write(merged)
        return 0

    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

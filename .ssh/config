Include ~/.colima/ssh_config

# Main SSH configuration
# Managed by yadm (Public Configuration)

# 1. Device-specific & Private configurations (Ignored by git)
Include config_local
Include config_hosts

# 2. Global defaults and Aliases
Host *
  AddKeysToAgent yes
  UseKeychain yes
  # Fallback: Generic key location (adjust name as needed)
  IdentityFile ~/.ssh/id_ed25519
  IdentityFile ~/.ssh/id_rsa

# Main SSH configuration
# Managed by yadm (Approach 1: Local Include with Fallback)

# 1. Device-specific configurations (Ignored by yadm)
Include config_local

# 2. Global defaults and Aliases
Host *
  AddKeysToAgent yes
  UseKeychain yes
  # Fallback: Generic key location (adjust name as needed)
  IdentityFile ~/.ssh/id_ed25519
  IdentityFile ~/.ssh/id_rsa

Host vps
    HostName lish-us-east.linode.com
    User mabino
    RequestTTY yes
    RemoteCommand ubuntu-us-east

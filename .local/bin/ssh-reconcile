#!/usr/bin/env python3
"""ssh-reconcile - Automated SSH key discovery, config_local reconciliation,

and macOS Keychain integration for portable dotfiles across machines.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import socket
import stat
import subprocess
import sys
from pathlib import Path
from typing import Dict, List, Optional, Set, Tuple

DEFAULT_SSH_DIR = Path.home() / ".ssh"
CONFIG_LOCAL_NAME = "config_local"

KEY_HEADER_MARKERS = (
    b"-----BEGIN OPENSSH PRIVATE KEY-----",
    b"-----BEGIN RSA PRIVATE KEY-----",
    b"-----BEGIN DSA PRIVATE KEY-----",
    b"-----BEGIN EC PRIVATE KEY-----",
    b"-----BEGIN PRIVATE KEY-----",
    b"PuTTY-User-Key-File",
)

IGNORED_FILENAMES = {
    "config",
    "config_local",
    "known_hosts",
    "known_hosts.old",
    "authorized_keys",
    "authorized_keys2",
    "environment",
    "rc",
}


def is_private_key_file(file_path: Path) -> bool:
    """Determine if a given file path is an SSH private key."""
    if not file_path.is_file() or file_path.is_symlink():
        return False

    name = file_path.name
    if name in IGNORED_FILENAMES or name.startswith(".") or name.endswith(".pub") or name.endswith(".old") or name.endswith(".bak"):
        return False

    try:
        with file_path.open("rb") as f:
            header = f.read(256)
            for marker in KEY_HEADER_MARKERS:
                if marker in header:
                    return True
    except (OSError, PermissionError):
        return False

    # Fallback: If companion .pub file exists and file is non-empty
    pub_companion = file_path.with_suffix(file_path.suffix + ".pub") if not file_path.name.endswith(".pub") else None
    if pub_companion and pub_companion.is_file():
        try:
            return file_path.stat().st_size > 0
        except OSError:
            pass

    return False


def get_machine_identifiers() -> List[str]:
    """Retrieve hostnames, local hostnames, and serial numbers for ranking keys."""
    identifiers: List[str] = []

    def _add(val: Optional[str]) -> None:
        if val:
            val_clean = val.strip()
            if val_clean and val_clean not in identifiers:
                identifiers.append(val_clean)
                short = val_clean.split(".")[0]
                if short and short not in identifiers:
                    identifiers.append(short)

    _add(socket.gethostname())

    if sys.platform == "darwin":
        for cmd in (["scutil", "--get", "LocalHostName"], ["scutil", "--get", "ComputerName"]):
            try:
                res = subprocess.run(cmd, capture_output=True, text=True, timeout=2)
                if res.returncode == 0:
                    _add(res.stdout)
            except Exception:
                pass

        try:
            res = subprocess.run(
                ["ioreg", "-l"],
                capture_output=True,
                text=True,
                timeout=2,
            )
            if res.returncode == 0:
                match = re.search(r'"IOPlatformSerialNumber"\s*=\s*"([^"]+)"', res.stdout)
                if match:
                    _add(match.group(1))
        except Exception:
            pass

    return identifiers


def discover_private_keys(ssh_dir: Optional[Path] = None) -> List[Path]:
    """Discover all private SSH keys in ssh_dir, sorted with machine-specific keys first."""
    target_dir = Path(ssh_dir or DEFAULT_SSH_DIR).expanduser()
    if not target_dir.is_dir():
        return []

    discovered: List[Path] = []
    try:
        for entry in target_dir.iterdir():
            if is_private_key_file(entry):
                discovered.append(entry)
    except OSError:
        return []

    machine_ids = get_machine_identifiers()

    def key_rank(p: Path) -> Tuple[int, str]:
        name = p.name
        # Highest priority: contains machine identifier / serial / hostname
        for idx, mid in enumerate(machine_ids):
            if mid.lower() in name.lower():
                return (0, f"{idx}_{name}")
        # Next priority: standard default names
        if name in ("id_ed25519", "id_ecdsa", "id_rsa", "id_ed25519_sk", "id_ecdsa_sk"):
            return (1, name)
        # Next priority: ends with standard suffixes
        if any(name.endswith(suffix) for suffix in ("_id_ed25519", "_id_ecdsa", "_id_rsa")):
            return (2, name)
        return (3, name)

    return sorted(discovered, key=key_rank)


def generate_config_local_content(keys: List[Path], ssh_dir: Optional[Path] = None) -> str:
    """Generate the config_local SSH configuration content for discovered keys."""
    target_dir = Path(ssh_dir or DEFAULT_SSH_DIR).expanduser()
    hostname = socket.gethostname().split(".")[0]

    lines = [
        f"# Auto-generated by ssh-reconcile on {hostname}. Do not edit manually.",
        "# Device-specific SSH identities for this machine.",
        "",
    ]

    if not keys:
        lines.append("# No device-specific private keys discovered in ~/.ssh")
    else:
        for k in keys:
            # Use ~/.ssh/ relative syntax if inside ~/.ssh, otherwise full path
            try:
                rel = k.relative_to(target_dir)
                identity_path = f"~/.ssh/{rel}"
            except ValueError:
                identity_path = str(k)
            lines.append(f"IdentityFile {identity_path}")

    lines.append("")
    return "\n".join(lines)


def sync_config_local(
    ssh_dir: Optional[Path] = None,
    config_local_name: str = CONFIG_LOCAL_NAME,
    dry_run: bool = False,
) -> Tuple[bool, List[Path], Path]:
    """Ensure ~/.ssh permissions and ~/.ssh/config_local is up-to-date.

    Returns: (changed, discovered_keys, config_local_path)
    """
    target_dir = Path(ssh_dir or DEFAULT_SSH_DIR).expanduser()
    if not target_dir.exists() and not dry_run:
        target_dir.mkdir(parents=True, mode=0o700, exist_ok=True)
    elif target_dir.exists() and not dry_run:
        try:
            target_dir.chmod(0o700)
        except OSError:
            pass

    keys = discover_private_keys(target_dir)

    # Secure permissions on discovered private keys
    if not dry_run:
        for k in keys:
            try:
                k.chmod(0o600)
            except OSError:
                pass

    config_local_path = target_dir / config_local_name
    new_content = generate_config_local_content(keys, target_dir)

    current_content = ""
    if config_local_path.is_file():
        try:
            current_content = config_local_path.read_text(encoding="utf-8")
        except OSError:
            pass

    changed = current_content != new_content

    if changed and not dry_run:
        tmp_path = config_local_path.with_suffix(".tmp")
        tmp_path.write_text(new_content, encoding="utf-8")
        tmp_path.chmod(0o600)
        tmp_path.replace(config_local_path)

    return changed, keys, config_local_path


def get_key_fingerprint(key_path: Path) -> Optional[str]:
    """Retrieve SHA256 fingerprint for a private or public key using ssh-keygen."""
    try:
        res = subprocess.run(
            ["ssh-keygen", "-l", "-f", str(key_path)],
            capture_output=True,
            text=True,
            timeout=3,
        )
        if res.returncode == 0 and res.stdout:
            parts = res.stdout.strip().split()
            if len(parts) >= 2:
                return parts[1]  # SHA256:...
    except Exception:
        pass
    return None


def get_loaded_agent_fingerprints() -> Set[str]:
    """Return set of key fingerprints currently loaded in ssh-agent."""
    fingerprints: Set[str] = set()
    try:
        res = subprocess.run(["ssh-add", "-l"], capture_output=True, text=True, timeout=3)
        if res.returncode == 0 and res.stdout:
            for line in res.stdout.strip().splitlines():
                parts = line.split()
                if len(parts) >= 2 and (parts[1].startswith("SHA256:") or parts[1].startswith("MD5:")):
                    fingerprints.add(parts[1])
    except Exception:
        pass
    return fingerprints


def is_key_in_apple_keychain(key_path: Path) -> bool:
    """Check if macOS Keychain has a stored passphrase for the key."""
    if sys.platform != "darwin":
        return False

    abs_path = str(key_path.resolve())
    try:
        res = subprocess.run(
            ["security", "find-generic-password", "-s", "SSH", "-a", abs_path],
            capture_output=True,
            timeout=3,
        )
        return res.returncode == 0
    except Exception:
        return False


def load_apple_keychain() -> Tuple[bool, str]:
    """Execute ssh-add --apple-load-keychain on macOS."""
    if sys.platform != "darwin":
        return True, "Keychain integration is macOS-only"

    try:
        res = subprocess.run(
            ["ssh-add", "--apple-load-keychain"],
            capture_output=True,
            text=True,
            timeout=5,
        )
        output = (res.stdout + res.stderr).strip()
        return res.returncode == 0, output
    except Exception as e:
        return False, str(e)


def enroll_key_in_keychain(key_path: Path) -> Tuple[bool, str]:
    """Add a key to ssh-agent and save passphrase to macOS Keychain."""
    cmd = ["ssh-add"]
    if sys.platform == "darwin":
        cmd.append("--apple-use-keychain")
    cmd.append(str(key_path))

    try:
        # Run interactively so the user can be prompted for the passphrase on tty / askpass
        res = subprocess.run(cmd)
        return res.returncode == 0, f"Enrolled {key_path.name}" if res.returncode == 0 else f"Failed to enroll {key_path.name}"
    except Exception as e:
        return False, str(e)


def inspect_key_status(key_path: Path, agent_fps: Set[str]) -> Dict[str, object]:
    """Inspect complete state of an individual private key."""
    fp = get_key_fingerprint(key_path)
    in_agent = bool(fp and fp in agent_fps)
    in_keychain = is_key_in_apple_keychain(key_path) if sys.platform == "darwin" else None

    return {
        "path": str(key_path),
        "name": key_path.name,
        "fingerprint": fp or "unknown",
        "in_agent": in_agent,
        "in_keychain": in_keychain,
    }


def cmd_status(args: argparse.Namespace) -> int:
    """Report complete status of SSH keys, ssh-agent, and macOS Keychain."""
    changed, keys, config_path = sync_config_local(dry_run=True)
    agent_fps = get_loaded_agent_fingerprints()
    auth_sock = os.environ.get("SSH_AUTH_SOCK", "")

    key_statuses = [inspect_key_status(k, agent_fps) for k in keys]

    if getattr(args, "json", False):
        payload = {
            "platform": sys.platform,
            "ssh_auth_sock": auth_sock,
            "agent_active": bool(auth_sock and os.path.exists(auth_sock)),
            "config_local": {
                "path": str(config_path),
                "exists": config_path.is_file(),
                "in_sync": not changed,
            },
            "keys": key_statuses,
        }
        print(json.dumps(payload, indent=2))
        return 0

    print("🔐 SSH & Keychain Status Report")
    print("=" * 40)
    print(f"Platform:        {sys.platform}")
    print(f"SSH Agent:       {'Active (' + auth_sock + ')' if auth_sock else 'Not configured'}")
    print(f"Local Config:    {config_path} ({'Synced' if not changed and config_path.is_file() else 'Needs update'})")
    print()

    if not keys:
        print("⚠️  No private SSH keys discovered in ~/.ssh")
        return 0

    print(f"Discovered Keys ({len(keys)}):")
    all_ready = True
    for st in key_statuses:
        name = st["name"]
        fp = st["fingerprint"]
        agent_str = "✅ Loaded in Agent" if st["in_agent"] else "❌ Not in Agent"
        if sys.platform == "darwin":
            kc_str = "✅ Stored in Keychain" if st["in_keychain"] else "❌ Not in Keychain"
            print(f"  • {name} [{fp}]")
            print(f"    - Agent:    {agent_str}")
            print(f"    - Keychain: {kc_str}")
            if not st["in_keychain"]:
                all_ready = False
        else:
            print(f"  • {name} [{fp}]: {agent_str}")
            if not st["in_agent"]:
                all_ready = False

    print()
    if all_ready:
        print("✨ All local SSH keys are properly configured and enrolled!")
    else:
        print("💡 Some keys are not enrolled in Keychain. Run 'ssh-reconcile enroll' to save passphrases.")

    return 0


def cmd_sync(args: argparse.Namespace) -> int:
    """Synchronize ~/.ssh/config_local with discovered private keys."""
    changed, keys, config_path = sync_config_local()
    if changed:
        print(f"✅ Updated {config_path} with {len(keys)} identity file(s):")
        for k in keys:
            print(f"   - {k.name}")
    else:
        print(f"✅ {config_path} is already up to date ({len(keys)} keys).")
    return 0


def cmd_load(args: argparse.Namespace) -> int:
    """Fast shell startup hook: syncs config, loads keychain, notifies if keys need enrollment."""
    changed, keys, _ = sync_config_local()

    if sys.platform == "darwin":
        load_apple_keychain()

    # If any keys exist, check if they are enrolled/loaded
    if keys:
        agent_fps = get_loaded_agent_fingerprints()
        unenrolled: List[Path] = []
        for k in keys:
            if sys.platform == "darwin":
                if not is_key_in_apple_keychain(k):
                    unenrolled.append(k)
            else:
                fp = get_key_fingerprint(k)
                if not (fp and fp in agent_fps):
                    unenrolled.append(k)

        if unenrolled and not getattr(args, "quiet", False):
            names = ", ".join(k.name for k in unenrolled)
            print(f"💡 SSH key(s) not in Keychain: {names}. Run 'ssh-reconcile enroll' to store passphrase permanently.", file=sys.stderr)

    return 0


def cmd_enroll(args: argparse.Namespace) -> int:
    """Enroll one or all local keys into macOS Keychain."""
    sync_config_local()
    keys = discover_private_keys()

    target_keys: List[Path] = []
    if getattr(args, "key", None):
        key_arg = Path(args.key).expanduser()
        if not key_arg.is_absolute():
            key_arg = DEFAULT_SSH_DIR / key_arg
        if not key_arg.is_file():
            print(f"❌ Key file not found: {key_arg}", file=sys.stderr)
            return 1
        target_keys = [key_arg]
    else:
        # Default: enroll unenrolled keys or all discovered keys
        for k in keys:
            if sys.platform == "darwin" and is_key_in_apple_keychain(k):
                continue
            target_keys.append(k)

        if not target_keys:
            if keys:
                print("✅ All discovered keys are already stored in Keychain.")
                if getattr(args, "force", False):
                    target_keys = keys
                else:
                    return 0
            else:
                print("❌ No SSH private keys found in ~/.ssh to enroll.", file=sys.stderr)
                return 1

    success_count = 0
    for k in target_keys:
        print(f"\n🔑 Enrolling key: {k.name} ({k})")
        if sys.platform == "darwin":
            print("   Passphrase will be saved to macOS Keychain (challenge once per machine)...")
        ok, msg = enroll_key_in_keychain(k)
        if ok:
            print(f"✅ Successfully enrolled {k.name}")
            success_count += 1
        else:
            print(f"❌ Failed to enroll {k.name}: {msg}", file=sys.stderr)

    return 0 if success_count == len(target_keys) else 1


def cmd_setup(args: argparse.Namespace) -> int:
    """End-to-end setup / bootstrap for a new machine."""
    print("🚀 Initializing SSH Key & Keychain Configuration...")
    changed, keys, config_path = sync_config_local()
    print(f"✅ Generated and verified {config_path} ({len(keys)} private keys found).")

    if sys.platform == "darwin":
        load_apple_keychain()

    # Check interactive terminal for enrollment
    is_interactive = sys.stdin.isatty() and not getattr(args, "non_interactive", False)
    if is_interactive and keys:
        unenrolled = [k for k in keys if sys.platform == "darwin" and not is_key_in_apple_keychain(k)]
        if unenrolled:
            print(f"\nFound {len(unenrolled)} unenrolled key(s): {', '.join(k.name for k in unenrolled)}")
            return cmd_enroll(args)

    return 0


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Auto-reconcile SSH config_local and macOS Keychain for multi-machine dotfiles."
    )
    subparsers = parser.add_subparsers(dest="command")

    # sync
    sync_parser = subparsers.add_parser("sync", aliases=["sync-config"], help="Sync ~/.ssh/config_local with discovered keys")
    sync_parser.set_defaults(func=cmd_sync)

    # load
    load_parser = subparsers.add_parser("load", help="Fast shell startup loader (used in .zshrc)")
    load_parser.add_argument("-q", "--quiet", action="store_true", help="Suppress warnings for unenrolled keys")
    load_parser.set_defaults(func=cmd_load)

    # status
    status_parser = subparsers.add_parser("status", help="Show SSH key, agent, and Keychain status")
    status_parser.add_argument("--json", action="store_true", help="Output status in JSON format")
    status_parser.set_defaults(func=cmd_status)

    # enroll
    enroll_parser = subparsers.add_parser("enroll", help="Enroll key(s) into macOS Keychain")
    enroll_parser.add_argument("key", nargs="?", help="Specific key filename or path to enroll")
    enroll_parser.add_argument("-f", "--force", action="store_true", help="Re-enroll even if already in Keychain")
    enroll_parser.set_defaults(func=cmd_enroll)

    # setup / bootstrap
    setup_parser = subparsers.add_parser("setup", aliases=["bootstrap"], help="Full setup for new machine or yadm bootstrap")
    setup_parser.add_argument("--non-interactive", action="store_true", help="Do not prompt interactively")
    setup_parser.set_defaults(func=cmd_setup)

    args = parser.parse_args()
    if not args.command:
        # Default action: status
        return cmd_status(args)

    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())

Include ~/.colima/ssh_config

# Main SSH configuration
# Managed by yadm

# 1. Device-specific configurations (Ignored by yadm)
Include config_local

# 2. Global defaults and Aliases
Host *
  AddKeysToAgent yes
  UseKeychain yes
  ServerAliveInterval 60
  ServerAliveCountMax 3
  Compression yes
  # Security: Disable deprecated algorithms
  HostKeyAlgorithms +ssh-ed25519-cert-v01@openssh.com,ssh-ed25519,ssh-rsa-cert-v01@openssh.com,ssh-rsa
  KexAlgorithms curve25519-sha256,curve25519-sha256@libssh.org,diffie-hellman-group-exchange-sha256
  Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com,aes256-ctr,aes192-ctr,aes128-ctr
  MACs hmac-sha2-256-etm@openssh.com,hmac-sha2-512-etm@openssh.com,hmac-sha1-etm@openssh.com
  # Fallback: Generic key location (adjust name as needed)
  IdentityFile ~/.ssh/id_ed25519
  IdentityFile ~/.ssh/id_rsa

Host vps-lish
    HostName lish-us-east.linode.com
    User mabino
    RequestTTY yes
    RemoteCommand ubuntu-us-east

Host vps
    HostName 10.0.0.1 
    User mabino
    ProxyJump home.bean

Host home.bean homelab
  HostName home.bean
  User mabino
  ForwardAgent yes

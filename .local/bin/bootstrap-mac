#!/usr/bin/env bash
# ~/.local/bin/bootstrap-mac
# Automated macOS bootstrap script for fresh machines, system repair, or full reset.
# Deterministically names machines FYB-<SerialNumber>, generates matching ED25519 keys,
# stores passphrases in Apple Keychain, uploads public keys to GitHub, and configures dotfiles.
#
# Usage on a fresh Mac:
#   /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/mabino/dotfiles/main/.local/bin/bootstrap-mac)"
#
# Reset / Start over:
#   /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/mabino/dotfiles/main/.local/bin/bootstrap-mac)" -- --reset
#   /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/mabino/dotfiles/main/.local/bin/bootstrap-mac)" -- --reinstall

set -euo pipefail

# --- Color and Logging Helpers ---
BOLD="\033[1m"
GREEN="\033[0;32m"
BLUE="\033[0;34m"
YELLOW="\033[0;33m"
RED="\033[0;31m"
RESET="\033[0m"

log_info()    { echo -e "${BLUE}${BOLD}==>${RESET} ${BOLD}$*${RESET}"; }
log_success() { echo -e "${GREEN}${BOLD}✔${RESET} ${GREEN}$*${RESET}"; }
log_warn()    { echo -e "${YELLOW}${BOLD}⚠${RESET} ${YELLOW}$*${RESET}"; }
log_error()   { echo -e "${RED}${BOLD}✖${RESET} ${RED}$*${RESET}" >&2; }

# --- Trap & Automated Cleanup ---
declare -a CLEANUP_FILES=()

cleanup() {
  local exit_code=$?
  # Remove registered temporary files
  for f in "${CLEANUP_FILES[@]:-}"; do
    [[ -n "$f" && -e "$f" ]] && rm -rf "$f"
  done
  # Clean up Xcode CLT sentinel if lingering
  rm -f /tmp/.com.apple.dt.CommandLineTools.installondemand.in-progress 2>/dev/null || true
  # Wipe sensitive variables from memory
  PASSPHRASE=""
  SSH_PASSPHRASE=""
  return "$exit_code" 2>/dev/null || exit "$exit_code"
}

trap cleanup EXIT INT TERM HUP

# --- Flags & Options ---
SILENT=0
SKIP_BREW=0
SKIP_XCODE=0
SKIP_LOCAL_AGENT=0
CUSTOM_KEY=""
RESET_ENV=0
REINSTALL=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    -s|--silent|-y|--yes|--non-interactive)
      SILENT=1
      shift
      ;;
    --reset|--clean|--uninstall)
      RESET_ENV=1
      shift
      ;;
    --reinstall)
      RESET_ENV=1
      REINSTALL=1
      shift
      ;;
    --skip-brew)
      SKIP_BREW=1
      shift
      ;;
    --skip-xcode)
      SKIP_XCODE=1
      shift
      ;;
    --skip-local-agent)
      SKIP_LOCAL_AGENT=1
      shift
      ;;
    --key|--ssh-key-name)
      CUSTOM_KEY="$2"
      shift 2
      ;;
    -h|--help)
      cat <<EOF
Usage: bootstrap-mac [OPTIONS]

Automated bootstrap script for macOS development machines.

Options:
  -s, --silent, -y, --yes     Run non-interactively (accepts all defaults)
  --reset, --clean            Reset bootstrap environment (removes ~/.homebrew, /opt/homebrew, ~/.oh-my-zsh, etc.)
  --reinstall                 Reset environment and immediately re-run full bootstrap
  --skip-brew                 Skip 'brew bundle' package installations
  --skip-xcode                Skip Xcode Command Line Tools verification
  --skip-local-agent          Skip local oMLX + Pi coding agent stack setup
  --ssh-key-name <NAME>       Specify a custom SSH key filename
  -h, --help                  Show this help message
EOF
      exit 0
      ;;
    *)
      shift
      ;;
  esac
done

# Safe prompt helper when piped via curl | bash
prompt_confirm() {
  local prompt_msg="$1"
  local default_yes="${2:-1}"

  if [[ "$SILENT" -eq 1 ]]; then
    return 0
  fi

  local prompt_suffix="[Y/n]"
  [[ "$default_yes" -eq 0 ]] && prompt_suffix="[y/N]"

  local reply=""
  if [[ -c /dev/tty ]]; then
    read -r -p "$(echo -e "${BOLD}${prompt_msg}${RESET} ${prompt_suffix} ")" reply </dev/tty
  else
    read -r -p "$(echo -e "${BOLD}${prompt_msg}${RESET} ${prompt_suffix} ")" reply || reply=""
  fi

  if [[ -z "$reply" ]]; then
    [[ "$default_yes" -eq 1 ]] && return 0 || return 1
  fi

  [[ "$reply" =~ ^[Yy]$ ]] && return 0 || return 1
}

# --- Reset / Clean Functionality ---
if [[ "$RESET_ENV" -eq 1 ]]; then
  echo -e "${RED}${BOLD}======================================================${RESET}"
  echo -e "${RED}${BOLD}🧹 macOS Bootstrap Environment Reset${RESET}"
  echo -e "${RED}${BOLD}======================================================${RESET}"
  echo

  if ! prompt_confirm "${YELLOW}Are you sure you want to clean up bootstrap installations (~/.homebrew, ~/.oh-my-zsh, etc.)?${RESET}" 1; then
    log_info "Reset canceled."
    exit 0
  fi

  log_info "Removing Homebrew installations from ~/.homebrew..."
  rm -rf "$HOME/.homebrew" "$HOME/homebrew" 2>/dev/null || true

  if [[ -d "/opt/homebrew" ]]; then
    log_info "Removing /opt/homebrew..."
    sudo rm -rf /opt/homebrew 2>/dev/null || rm -rf /opt/homebrew 2>/dev/null || log_warn "Could not remove /opt/homebrew without sudo."
  fi

  log_info "Cleaning temporary installation artifacts..."
  rm -rf /tmp/Homebrew* /tmp/homebrew* /tmp/.com.apple.dt.* 2>/dev/null || true

  log_info "Removing Oh My Zsh (~/.oh-my-zsh)..."
  rm -rf "$HOME/.oh-my-zsh" 2>/dev/null || true

  log_info "Removing AI instruction symlinks..."
  rm -f "$HOME/.claude/CLAUDE.md" "$HOME/.gemini/GEMINI.md" "$HOME/.copilot/copilot-instructions.md" 2>/dev/null || true

  log_info "Removing local SSH config_local..."
  rm -f "$HOME/.ssh/config_local" 2>/dev/null || true

  log_success "Reset complete. Environment is clean!"
  echo

  if [[ "$REINSTALL" -eq 0 ]]; then
    echo -e "You can start fresh anytime by running: ${BOLD}bootstrap-mac${RESET}"
    exit 0
  fi
  log_info "Proceeding with fresh reinstall..."
  echo
fi

echo -e "${BOLD}======================================================${RESET}"
echo -e "${BOLD}🚀 macOS Development Machine Bootstrap & Setup${RESET}"
echo -e "${BOLD}======================================================${RESET}"
echo

# --- Step 1: Hardware Identification (FYB-<SerialNumber>) ---
log_info "Step 1/9: Detecting hardware identification..."
SERIAL="$(ioreg -rd1 -c IOPlatformExpertDevice 2>/dev/null | awk -F'"' '/IOPlatformSerialNumber/{print $4}' || true)"
if [[ -n "$SERIAL" ]]; then
  MACHINE_ID="FYB-${SERIAL}"
  log_success "Detected machine identifier: ${BOLD}${MACHINE_ID}${RESET} (Serial: ${SERIAL})"
else
  MACHINE_ID="$(scutil --get LocalHostName 2>/dev/null || scutil --get ComputerName 2>/dev/null || hostname -s)"
  MACHINE_ID="$(echo "$MACHINE_ID" | tr ' ' '-')"
  log_info "Fallback machine identifier: ${MACHINE_ID}"
fi

# Ensure macOS ComputerName / HostName matches FYB-###
if [[ "$(uname -s)" == "Darwin" && -n "$SERIAL" ]]; then
  CURRENT_NAME="$(scutil --get ComputerName 2>/dev/null || true)"
  if [[ "$CURRENT_NAME" != "$MACHINE_ID" && "$SILENT" -eq 0 ]]; then
    if prompt_confirm "Set macOS ComputerName and HostName to '${MACHINE_ID}'?" 1; then
      sudo scutil --set ComputerName "$MACHINE_ID" 2>/dev/null || true
      sudo scutil --set HostName "$MACHINE_ID" 2>/dev/null || true
      sudo scutil --set LocalHostName "$MACHINE_ID" 2>/dev/null || true
      log_success "Computer name set to ${MACHINE_ID}"
    fi
  fi
fi

# --- Step 2: Xcode Command Line Tools ---
if [[ "$SKIP_XCODE" -eq 0 && "$(uname -s)" == "Darwin" ]]; then
  log_info "Step 2/9: Verifying Xcode Command Line Tools..."
  if ! xcode-select -p >/dev/null 2>&1; then
    echo
    echo -e "${YELLOW}${BOLD}======================================================${RESET}"
    echo -e "${YELLOW}${BOLD}📦 ACTION REQUIRED: Xcode Command Line Tools${RESET}"
    echo -e "${YELLOW}${BOLD}======================================================${RESET}"
    echo -e "${YELLOW}A native macOS installer window has opened on your screen.${RESET}"
    echo
    echo -e "  1. Switch to the ${BOLD}'Install Command Line Developer Tools'${RESET} dialog."
    echo -e "  2. Click ${BOLD}Install${RESET} and accept the Apple license agreement."
    echo -e "  3. Wait for the progress bar to complete."
    echo
    echo -e "${YELLOW}${BOLD}======================================================${RESET}"
    echo

    touch /tmp/.com.apple.dt.CommandLineTools.installondemand.in-progress
    xcode-select --install 2>/dev/null || true

    if [[ "$SILENT" -eq 0 && -c /dev/tty ]]; then
      read -r -p "$(echo -e "${BOLD}👉 Press [Enter] here once the GUI installation has finished...${RESET}")" </dev/tty
    fi

    # Verification and wait loop
    if ! xcode-select -p >/dev/null 2>&1; then
      echo -e "Waiting for Xcode Command Line Tools verification..."
      until xcode-select -p >/dev/null 2>&1; do
        sleep 3
      done
    fi
    rm -f /tmp/.com.apple.dt.CommandLineTools.installondemand.in-progress
    log_success "Xcode Command Line Tools installed and verified: $(xcode-select -p)"
  else
    log_success "Xcode Command Line Tools active: $(xcode-select -p)"
  fi
fi

# --- Step 3: Homebrew Installation & Environment ---
log_info "Step 3/9: Verifying Homebrew environment..."
_BREW_BIN=""
for _cand in "$HOME/.homebrew/bin/brew" "$HOME/homebrew/bin/brew" /opt/homebrew/bin/brew /usr/local/bin/brew; do
  if [[ -x "$_cand" ]]; then
    _BREW_BIN="$_cand"
    break
  fi
done

if [[ -z "$_BREW_BIN" ]]; then
  log_info "Homebrew not found. Installing Homebrew directly into $HOME/.homebrew (no sudo/opt)..."
  mkdir -p "$HOME/.homebrew"
  curl -fsSL https://github.com/Homebrew/brew/tarball/master | tar xz --strip 1 -C "$HOME/.homebrew"
  _BREW_BIN="$HOME/.homebrew/bin/brew"
fi

if [[ -n "$_BREW_BIN" ]]; then
  eval "$("$_BREW_BIN" shellenv)"
  export PATH="${_BREW_BIN%/brew}:$HOME/.local/bin:$PATH"
  log_success "Homebrew active: $(command -v brew) (Prefix: $("$_BREW_BIN" --prefix))"
else
  log_warn "Homebrew could not be located in standard prefixes."
fi

# Ensure core CLI dependencies are present via Homebrew
if command -v brew >/dev/null 2>&1; then
  declare -a missing_core=()
  command -v gh >/dev/null 2>&1 || missing_core+=(gh)
  command -v yadm >/dev/null 2>&1 || missing_core+=(yadm)
  command -v uv >/dev/null 2>&1 || missing_core+=(uv)
  if [[ ${#missing_core[@]} -gt 0 ]]; then
    log_info "Installing missing core tools (${missing_core[*]}) via Homebrew..."
    brew install "${missing_core[@]}"
  else
    log_success "Core tools (gh, yadm, uv) are ready."
  fi
fi

# --- Step 4: SSH Key Creation & Keychain Enrollment ---
log_info "Step 4/9: Managing local SSH key & macOS Keychain integration..."
mkdir -p "$HOME/.ssh"
chmod 700 "$HOME/.ssh"

# Pre-seed github.com into known_hosts
if ! grep -q "github.com" "$HOME/.ssh/known_hosts" 2>/dev/null; then
  ssh-keyscan -t ed25519,rsa github.com 2>/dev/null >> "$HOME/.ssh/known_hosts" || true
fi

if [[ -n "$CUSTOM_KEY" ]]; then
  KEY_NAME="$CUSTOM_KEY"
else
  KEY_NAME="${MACHINE_ID}_id_ed25519"
fi
KEY_PATH="$HOME/.ssh/$KEY_NAME"

if [[ ! -f "$KEY_PATH" ]]; then
  # Check if another private key already exists
  EXISTING_KEY=""
  for f in "$HOME/.ssh/${MACHINE_ID}_id_ed25519" "$HOME/.ssh/"*_id_ed25519 "$HOME/.ssh/"id_ed25519 "$HOME/.ssh/"id_rsa; do
    if [[ -f "$f" && ! "$f" =~ \.pub$ ]]; then
      EXISTING_KEY="$f"
      break
    fi
  done

  if [[ -n "$EXISTING_KEY" ]]; then
    KEY_PATH="$EXISTING_KEY"
    KEY_NAME="$(basename "$EXISTING_KEY")"
    log_info "Discovered existing SSH key: $KEY_NAME"
  else
    log_info "Generating new ED25519 SSH key: ${KEY_NAME}"
    PASSPHRASE=""
    if [[ "$SILENT" -eq 1 ]]; then
      PASSPHRASE="${SSH_PASSPHRASE:-}"
    else
      echo -e "${YELLOW}Enter your Mac's login password (used to encrypt SSH key & enroll in Keychain):${RESET}"
      if [[ -c /dev/tty ]]; then
        read -s -r PASSPHRASE </dev/tty
      else
        read -s -r PASSPHRASE || PASSPHRASE=""
      fi
      echo
    fi

    # Generate key
    ssh-keygen -t ed25519 -f "$KEY_PATH" -N "$PASSPHRASE" -C "mabino@${MACHINE_ID}.local"
    log_success "Generated key at $KEY_PATH"

    # Enroll in macOS Keychain with SSH_ASKPASS to avoid second prompt
    if [[ "$(uname -s)" == "Darwin" && -n "$PASSPHRASE" ]]; then
      ASKPASS_TMP="$(mktemp)"
      CLEANUP_FILES+=("$ASKPASS_TMP")
      echo '#!/bin/sh' > "$ASKPASS_TMP"
      echo "echo '$PASSPHRASE'" >> "$ASKPASS_TMP"
      chmod 700 "$ASKPASS_TMP"
      SSH_ASKPASS="$ASKPASS_TMP" SSH_ASKPASS_REQUIRE=force DISPLAY=:0 ssh-add --apple-use-keychain "$KEY_PATH" >/dev/null 2>&1 || true
      rm -f "$ASKPASS_TMP"
      log_success "Passphrase saved to macOS Keychain for $KEY_NAME"
    fi
  fi
fi

chmod 600 "$KEY_PATH"
if [[ -f "$KEY_PATH" && ! -f "${KEY_PATH}.pub" ]]; then
  ssh-keygen -y -f "$KEY_PATH" > "${KEY_PATH}.pub" 2>/dev/null || true
fi
[[ -f "${KEY_PATH}.pub" ]] && chmod 644 "${KEY_PATH}.pub"

# Make sure key is loaded in running agent
if [[ "$(uname -s)" == "Darwin" ]]; then
  ssh-add --apple-load-keychain >/dev/null 2>&1 || true
fi

# --- Step 5: GitHub CLI (gh) & Public Key Registration ---
log_info "Step 5/9: Registering SSH key with GitHub..."
if command -v gh >/dev/null 2>&1; then
  if ! gh auth status >/dev/null 2>&1; then
    if [[ -c /dev/tty && "$SILENT" -eq 0 ]]; then
      log_info "Logging into GitHub CLI to authorize SSH key..."
      gh auth login -w -p ssh </dev/tty || true
    fi
  fi

  if gh auth status >/dev/null 2>&1 && [[ -f "${KEY_PATH}.pub" ]]; then
    PUB_CONTENT="$(cat "${KEY_PATH}.pub")"
    if ! gh ssh-key list 2>/dev/null | grep -q "$MACHINE_ID"; then
      log_info "Uploading ${KEY_NAME}.pub to GitHub as '${MACHINE_ID}'..."
      gh ssh-key add "${KEY_PATH}.pub" --title "$MACHINE_ID" --type authentication && log_success "SSH public key registered on GitHub!" || log_warn "Could not add key automatically."
    else
      log_success "SSH key '${MACHINE_ID}' is already registered on GitHub."
    fi
  fi
fi

# --- Step 6: Yadm Installation & Dotfiles Clone ---
log_info "Step 6/9: Managing Dotfiles via yadm..."
DOTFILES_REPO="git@github.com:mabino/dotfiles.git"
DOTFILES_HTTPS="https://github.com/mabino/dotfiles.git"

if ! yadm rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  log_info "Cloning dotfiles repository..."
  # Try SSH clone first
  if yadm clone "$DOTFILES_REPO" 2>/dev/null; then
    log_success "Cloned dotfiles via SSH."
  else
    log_info "Cloning dotfiles repository via HTTPS..."
    yadm clone "$DOTFILES_HTTPS"
    yadm remote set-url origin "$DOTFILES_REPO" 2>/dev/null || true
    log_success "Cloned dotfiles (origin remote set to SSH)."
  fi
else
  log_info "Existing yadm dotfiles repository detected. Pulling latest changes..."
  yadm pull --rebase --autostash --quiet 2>/dev/null || true
fi

# --- Step 7: Git Configuration, Hooks & SSH Reconciliation ---
log_info "Step 7/9: Configuring Git hooks, merge driver & SSH config..."
git config --global core.hooksPath "$HOME/.config/git/hooks"
if command -v yadm >/dev/null 2>&1; then
  yadm gitconfig merge.brewfile-union.name "Union merge for Brewfiles"
  yadm gitconfig merge.brewfile-union.driver "$HOME/.local/bin/brewfile-reconcile git-merge %O %A %B"
fi

# Reconcile SSH config_local
if [[ -x "$HOME/.local/bin/ssh-reconcile" ]]; then
  "$HOME/.local/bin/ssh-reconcile" sync >/dev/null 2>&1 || true
  "$HOME/.local/bin/ssh-reconcile" load --quiet || true
  log_success "SSH config_local synchronized for ${MACHINE_ID}."
fi

# Link master AI instruction file
mkdir -p "$HOME/.claude" "$HOME/.gemini" "$HOME/.copilot"
if [[ -f "$HOME/.AGENT.md" ]]; then
  ln -sf "$HOME/.AGENT.md" "$HOME/.claude/CLAUDE.md"
  ln -sf "$HOME/.AGENT.md" "$HOME/.gemini/GEMINI.md"
  ln -sf "$HOME/.AGENT.md" "$HOME/.copilot/copilot-instructions.md"
  log_success "AI instruction symlinks configured for Claude, Gemini, and Copilot."
fi

# Verify / Install Oh My Zsh
if [[ ! -d "$HOME/.oh-my-zsh" ]]; then
  log_info "Installing Oh My Zsh (unattended)..."
  RUNZSH=no CHSH=no KEEP_ZSHRC=yes sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended >/dev/null 2>&1 || true
  log_success "Oh My Zsh installed."
else
  log_success "Oh My Zsh active: $HOME/.oh-my-zsh"
fi

# --- Step 8: Homebrew Package Bundle & Mise ---
if [[ "$SKIP_BREW" -eq 0 && -f "$HOME/.Brewfile" ]]; then
  log_info "Step 8/9: Installing Homebrew packages & developer toolchains..."
  if prompt_confirm "Run 'brew bundle --global' to install tracked packages and CLI tools?" 1; then
    brew bundle --global --verbose || log_warn "Some brew bundle packages may have encountered issues."
    log_success "Homebrew bundle installed."
  else
    log_info "Skipping brew bundle per user choice. Run 'brew bundle --global' anytime later."
  fi
else
  log_info "Step 8/9: Skipping Homebrew package bundle."
fi

# Mise runtime activation
if command -v mise >/dev/null 2>&1; then
  log_info "Checking mise runtime versions..."
  mise install 2>/dev/null || true
fi

# --- Step 9: Local MLX Agent Stack (High-Memory Apple Silicon) ---
if [[ "$SKIP_LOCAL_AGENT" -eq 0 && -x "$HOME/.local/bin/bootstrap-local-agent" ]]; then
  log_info "Step 9/9: Evaluating local MLX coding agent stack eligibility..."
  if [[ "$SILENT" -eq 1 ]]; then
    "$HOME/.local/bin/bootstrap-local-agent" --silent || log_warn "Local agent bootstrap skipped or encountered issues."
  else
    "$HOME/.local/bin/bootstrap-local-agent" || log_warn "Local agent bootstrap skipped or encountered issues."
  fi
else
  log_info "Step 9/9: Skipping local MLX coding agent stack."
fi

echo
echo -e "${GREEN}${BOLD}======================================================${RESET}"
echo -e "${GREEN}${BOLD}✨ Machine ${MACHINE_ID} Bootstrap Complete!${RESET}"
echo -e "${GREEN}${BOLD}======================================================${RESET}"
echo
echo -e "Summary for ${BOLD}${MACHINE_ID}${RESET}:"
echo -e "  • SSH Key:       ~/.ssh/${KEY_NAME} (stored in Keychain)"
echo -e "  • GitHub Auth:   Public key registered as '${MACHINE_ID}'"
echo -e "  • Dotfiles:      Managed via yadm (remote: ${DOTFILES_REPO})"
echo -e "  • AI Master:     ~/.AGENT.md (linked to Claude, Gemini, Copilot)"
echo
echo -e "Next steps:"
echo -e "  1. Reload your shell: ${BOLD}exec zsh${RESET} or open a new terminal tab"
echo -e "  2. Verify SSH and Keychain status anytime via: ${BOLD}ssh-reconcile status${RESET}"
echo
